# ── Docker environment ────────────────────────────────────────────────────────
# Use this when running with docker-compose.
# Hostnames = Docker service names (NOT localhost)
# Your regular .env uses localhost for running directly on your machine.

# PostgreSQL
POSTGRES_URL=postgresql+psycopg2://tender_user:tender_pass@postgres:5432/tender_db

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Windows-only paths are NOT needed inside Linux containers
TESSERACT_CMD=
POPPLER_PATH=
